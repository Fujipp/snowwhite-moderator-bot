# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token

# Client ID and Guild ID
CLIENT_ID=your_client_id
GUILD_ID=your_guild_id

# Database (Postgres/Neon)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Optional: Project settings
# PROJECT_ID=discord-bot-topup
# PROJECT_NAME=Discord Bot Topup

# Optional: JSON data paths for migration
# NEWDATA_PATH=data/newdata.json
# TOPUP_HISTORY_PATH=data/topup_history.json

# Optional: RLS settings
# RLS_ROLE=your_db_role
# RLS_POLICY_PREFIX=bot_all
